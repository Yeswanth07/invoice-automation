    {
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $json.spreadsheetId }}?fields=sheets.properties(sheetId,title,index)",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "1658fed5-4507-4bde-b22d-a122ce857b2c",
      "name": "Get Sheet List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "L0rkqfP0tXLoe6AQ",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst sheets = $input.first().json.sheets.map(s => s.properties);\n\nconst now = $now; // uses the workflow timezone (Asia/Kolkata)\nconst newName = now.toFormat('LLLL yyyy'); // e.g. \"September 2026\"\n\n// Stop quietly if this month's sheet already exists (safe to re-run)\nif (sheets.some(s => s.title === newName)) {\n  return [];\n}\n\n// Latest sheet = tab whose name is the most recent \"Month YYYY\".\n// Falls back to the right-most tab if no tab names parse as dates.\nconst dated = sheets\n  .map(s => ({ ...s, dt: DateTime.fromFormat(s.title, 'LLLL yyyy') }))\n  .filter(s => s.dt.isValid)\n  .sort((a, b) => b.dt.toMillis() - a.dt.toMillis());\nconst latest = dated[0] || sheets.reduce((a, b) => (a.index > b.index ? a : b));\n\nconst start = now.startOf('month');\nconst end = now.endOf('month');\n\nreturn [{\n  json: {\n    spreadsheetId: cfg.spreadsheetId,\n    toEmail: cfg.toEmail,\n    invoiceNoCell: cfg.invoiceNoCell,\n    invoiceDateCell: cfg.invoiceDateCell,\n    periodCell: cfg.periodCell,\n    sourceSheetId: latest.sheetId,\n    sourceTitle: latest.title,\n    newIndex: latest.index + 1,\n    newName,\n    invoiceDate: end.toFormat('dd-LL-yyyy'),\n    period: `${start.toFormat('dd-LL-yyyy')} to ${end.toFormat('dd-LL-yyyy')}`,\n  },\n}];"
      },
      "id": "c013c4e3-3be8-4d60-92a1-186827c75706",
      "name": "Plan New Sheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $json.spreadsheetId }}/values/{{ encodeURIComponent(\"'\" + $json.sourceTitle + \"'!\" + $json.invoiceNoCell) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "27ac126a-a308-4f37-9e8c-79682a2f713a",
      "name": "Read Last Invoice No",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "L0rkqfP0tXLoe6AQ",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Plan New Sheet').first().json;\nconst prev = String($input.first().json.values?.[0]?.[0] ?? '');\n\n// Increment the first number in the invoice no, keeping zero padding: INV_05 -> INV_06\nconst m = prev.match(/\\d+/);\nif (!m) {\n  throw new Error(`No number found in '${plan.sourceTitle}'!${plan.invoiceNoCell} (value: \"${prev}\")`);\n}\nconst next = String(Number(m[0]) + 1).padStart(m[0].length, '0');\nconst invoiceNo = prev.slice(0, m.index) + next + prev.slice(m.index + m[0].length);\n\nconst tab = `'${plan.newName}'!`;\n\nreturn [{\n  json: {\n    ...plan,\n    prevInvoiceNo: prev,\n    invoiceNo,\n    duplicateBody: {\n      requests: [{\n        duplicateSheet: {\n          sourceSheetId: plan.sourceSheetId,\n          insertSheetIndex: plan.newIndex,\n          newSheetName: plan.newName,\n        },\n      }],\n    },\n    updateBody: {\n      valueInputOption: 'RAW',\n      data: [\n        { range: tab + plan.invoiceNoCell, values: [[invoiceNo]] },\n        { range: tab + plan.invoiceDateCell, values: [[plan.invoiceDate]] },\n        { range: tab + plan.periodCell, values: [[plan.period]] },\n      ],\n    },\n  },\n}];"
      },
      "id": "473c4cae-4127-4c0a-9195-2c7e396e7b47",
      "name": "Next Invoice No",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        0
      ]
    },
