    {
      "parameters": {
        "jsCode": "const d = $('Next Invoice No').first().json;\nconst item = $input.first();\nitem.binary.data.fileName = `${d.invoiceNo}_${d.newName.replace(/\\s+/g, '_')}.pdf`;\nitem.binary.data.mimeType = 'application/pdf';\nitem.binary.data.fileExtension = 'pdf';\nitem.json = {\n  toEmail: d.toEmail,\n  invoiceNo: d.invoiceNo,\n  newName: d.newName,\n  invoiceDate: d.invoiceDate,\n  period: d.period,\n};\nreturn [item];"
      },
