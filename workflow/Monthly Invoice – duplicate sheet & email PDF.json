      "parameters": {
        "jsCode": "const invoice = $('Name PDF').first();\nconst decl = $('Download Declaration PDF').first();\nconst d = $('Next Invoice No').first().json;\n\nreturn [{\n  json: invoice.json,\n  binary: {\n    data: invoice.binary.data,\n    declaration: {\n      ...decl.binary.declaration,\n      fileName: `Non-GST_Declaration_${d.newName.replace(/\\s+/g, '_')}.pdf`,\n    },\n  },\n}];"
