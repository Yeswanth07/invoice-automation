    {
      "parameters": {
        "sendTo": "={{ $json.toEmail }}",
        "subject": "=Invoice {{ $json.invoiceNo }} – {{ $json.newName }}",
        "message": "=<div style=\"font-family: 'Times New Roman', Times, serif; font-size: 16px; color: #000000;\">\n<p>Dear Bhagya,</p>\n<p>Hope you are doing well.</p>\n<p>Please find attached invoice {{ $json.invoiceNo }} dated {{ $json.invoiceDate }} for the period {{ $json.period }}, along with the GST Non-Enrollment declaration.</p>\n<p>Kindly review the documents and let me know if any further information or clarification is required.</p>\n<p>I look forward to your confirmation.</p>\n<p>Thanks &amp; regards</div>",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "data,declaration"
              }
            ]
          }
        }
      },
