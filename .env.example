# Copy this file to .env and fill in the values.  (.env is never committed to git)

# Google OAuth client
# Ask the developer for these privately, or create your own (see README, "Using your own Google client").
GOOGLE_CLIENT_ID=PASTE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_CLIENT_SECRET_HERE

# Timezone used for the schedule and invoice dates
TIMEZONE=Asia/Kolkata

# n8n version. "latest" is fine; pin a version (e.g. the one in Settings -> About) for stability.
N8N_VERSION=latest

# Leave false. Set to true ONLY to re-import the workflow and credentials from scratch.
# WARNING: re-importing overwrites your Config edits and disconnects your Google sign-ins.
FORCE_SETUP=false
